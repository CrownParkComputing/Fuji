<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ST Desk</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<!-- Taken from the build setting so CI's timestamp actually reaches the
	     bundle. Hardcoding it meant every delivery claimed to be build 1, and
	     App Store Connect refuses a CFBundleVersion it has seen before,
	     reporting it only after the whole upload has transferred. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The app does not record anything. AVAudioSession is linked because
	     that is how the bridge plays the ST's sound (core/retro/bridge/
	     audio_sink_ios.m), and iOS demands the purpose string from any
	     bundle that LINKS a protected API whether or not it ever calls it.
	     Apple reports the lack only AFTER a delivery that reported success:
	     ITMS-90683, by email, hours later, with CI green. The iOS job
	     checks for it against `nm -u` on the built binary rather than
	     against a list someone remembered to update, which is how this was
	     caught before the first upload rather than after it. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ST Desk does not record audio. This entry is required because the audio library the app uses to play Atari ST sound links Apple's audio-session API, and iOS asks for the description whether or not recording is ever used.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- The disk-image formats the bridge accepts. Declared as imported types
	     so SwiftUI's fileImporter can name them; .zip stays the system's own
	     public.zip and needs no declaration here. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.crownparkcomputing.stdesk.atari-disk-image</string>
			<key>UTTypeDescription</key>
			<string>Atari ST Disk Image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>st</string>
					<string>msa</string>
					<string>dim</string>
					<string>stx</string>
					<string>img</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.crownparkcomputing.stdesk.atari-ipf</string>
			<key>UTTypeDescription</key>
			<string>Atari ST Preservation Image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ipf</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- All four, and not by preference: an app that declares the iPad device
	     family must support every orientation for multitasking, or App Store
	     Connect rejects the upload outright with a 409. The phone is free to
	     stay landscape-only, which is why the key above is unchanged. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
